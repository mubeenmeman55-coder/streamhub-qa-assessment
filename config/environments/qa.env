# Non-secret environment configuration (selected with TEST_ENV, default "qa")
API_BASE_URL=http://localhost:3100
# Start the bundled mock API automatically for @api scenarios
START_API_SERVER=true
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT_MS=15000
# Section A: the EMI calculator web app built in this repo (started automatically by the test hooks)
WEBAPP_URL=http://localhost:3300
START_WEBAPP=true
# Section A3: public fake API under test
JSONPLACEHOLDER_URL=https://jsonplaceholder.typicode.com
# Section A3 (strict): a local posts API that really validates input; started automatically by the test hooks
POSTS_API_URL=http://localhost:3400
START_POSTS_API=true
